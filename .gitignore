# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
.env

# --- build / generated RTL ---
build/
engine.v
engine.ir
engine.opt.ir
*.ir
*.opt.ir
*.vvp

# --- captures / media (regenerated) ---
media/
test/out/
*.wav
*.mp4
# ...except the milestone clips embedded in the slide deck (kept so it stays self-contained)
# and the two demo songs embedded in the README.
!docs/slides/assets/videos/*.mp4
!docs/assets/*.mp4

# --- local secrets / certs / large corpora (never commit) ---
webui/certs/
presetgen/.freesound_token
presetgen/.freesound_account
presetgen/targets_freesound/
presetgen/targets_soundfont/
presetgen/demo_out/
presetgen/__pycache__/
# name_audit.py output: regenerable from the banks in one command, and it moves whenever the
# CLAP checkpoint or the prompts do, so a committed copy would go stale silently.
presetgen/name_audit*.json
# ab_render.py output: ~10 MB of WAV plus the manifest that says which bank is A. Regenerable in a
# minute from the banks, and committing the manifest would put the answer key in the repo.
webui/ab/
# build_previews.py output: ~60 MB of audition WAV, regenerable from the banks in one command.
webui/static/preview/
# xmod_probe.py output: the measurement, plus both re-fit arms as an auditionable bank. The bank
# is a probe and not something anyone should be able to load onto a board -- and since synthspec
# globs presets_*.json, leaving it in place also puts it into a rebuilt spec.json. Regenerate,
# listen, delete, rebuild the spec.
presetgen/xmod_probe.json
webui/presets_xmodprobe.json

# $SPACE arm banks: build_presets.py output for the search-space experiment (issue #16). Four
# banks over the same 64 targets at four widths, of which at most one can ever ship -- and since
# synthspec globs presets_*.json, leaving them in place would put all four into a rebuilt
# spec.json as browser tabs. Promote the winner by rewriting presets_soundfont.json, delete the
# rest.
webui/presets_arm*.json

# Budget arms, same rule and the same reason (issue #17). presets_pilot800/3000 are the 16-target
# pilot that decided the budget; presets_b3000 is the full 64-slot re-fit that is A/B'd against the
# shipped bank. Promote by rewriting presets_soundfont.json, delete the rest.
webui/presets_pilot*.json
webui/presets_b[0-9]*.json

# attack_audit.py output: a measurement of whatever banks happened to be on disk when it ran, so
# it is reproducible from the banks and stale the moment one is re-fitted. The numbers worth
# keeping are quoted in DEVELOPMENT.md.
presetgen/attack_audit.json

# stray screenshots
Screenshot*.png
